# Application Environment
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://paperglow.co.ke

# Database Configuration (MySQL / MariaDB on DirectAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=papergl1_paperglow
DB_USER=papergl1_paperglow
DB_PASSWORD=your_secure_database_password_here

# Authentication & Security
# Generate with: openssl rand -base64 48
JWT_SECRET=generate_a_cryptographically_secure_random_key_min_32_characters

# Media Storage Configuration
STORAGE_DRIVER=local
STORAGE_DIR=./uploads